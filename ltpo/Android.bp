cc_binary {
    name: "infiniti_ltpo_service",
    srcs: ["main.cpp"],
    init_rc: ["infiniti_ltpo_service.rc"],
    system_ext_specific: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    static_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "android.hardware.graphics.common-V7-ndk",
        "//vendor/qcom/opensource/commonsys-intf/display:vendor.qti.hardware.display.config-V15-ndk",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
}
